{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-finance-moyu",
  "version": "0.3.3",
  "identifier": "com.moyu.finance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "moyu",
        "width": 320,
        "height": 170,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focusable": false,
        "resizable": true,
        "maximizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2ODFDMUM5MEUzQzk0RkUKUldUK2xEd095Y0dCQmhvS2JLN0dQM1dJbW5XYTd5OThSK01kdk1IZjgvM25wQUxzN2hWek9Wa2YK",
      "endpoints": [
        "https://ghfast.top/https://github.com/ikomom/ai-finance-moyu/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/ikomom/ai-finance-moyu/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/ikomom/ai-finance-moyu/releases/latest/download/latest.json",
        "https://github.com/ikomom/ai-finance-moyu/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
